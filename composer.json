{
    "name": "clintonnzedimma/woskiphp",
    "description": "Woski is a simple fast PHP framework for the Realm.",
    "keywords": [
        "phpframework",
        "woski",
        "woskiphp"
    ],
    "homepage": "https://github.com/clintonnzedimma/woski",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "require": {
        "php": ">=7.4",
        "vlucas/phpdotenv": "^4.1",
        "filp/whoops": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "Woski\\": "core/",
            "App\\": "app/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    }
}